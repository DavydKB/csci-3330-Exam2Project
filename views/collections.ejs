<%- include("partials/header") %>
<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Your Collections</h1>

        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#addMediaModal">
            Add Media
        </button>
    </div>
    <!-- Categories -->
    <section class="mb-5">
        <h3 class="mb-3">Categories</h3>

        <div class="d-flex flex-wrap gap-2">
            <a href="#" class="btn btn-outline-light">All</a>
            <a href="#" class="btn btn-outline-light">Games</a>
            <a href="#" class="btn btn-outline-light">Movies</a>
            <a href="#" class="btn btn-outline-light">Anime</a>
            <a href="#" class="btn btn-outline-light">Manga</a>
        </div>
    </section>

    <!-- Tags -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Tags</h3>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <% tags.forEach(tag => { %>
                <span class="badge text-bg-secondary fs-6 p-2">
                    <%= tag.name %>
                </span>
            <% }) %>

            <% if (tags.length === 0) { %>
                <p class="text-muted">No tags created yet.</p>
            <% } %>
        </div>
    </section>

    <hr class="my-4">
    
    <!-- Media -->
    <section>
        <h3 class="mb-3">Media Collection</h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            <% media.forEach(item => { %>
                <%- include("partials/mediaCard", {
                    item: item,
                    tracker: trackers.find(t => t.mediaId === item.id)
                }) %>
            <% }) %>
        </div>
    </section>
<%- include("partials/addMediaModal") %>
</main>

<%- include("partials/footer") %>
