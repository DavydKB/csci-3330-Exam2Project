<!-- Edit Media Modal -->
        <div class="modal fade" id="editMediaModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Edit Media</h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <form action="/media/<%= media.id %>/edit" method="POST"
                          enctype="multipart/form-data">

                        <div class="modal-body">

                            <div class="mb-3">
                                <label for="editTitle" class="form-label">Title</label>
                                <input type="text" class="form-control"
                                    id="editTitle" name="title"
                                    value="<%= media.title %>" required>
                            </div>

                            <div class="mb-3">
                                <label for="editCategory" class="form-label">Category</label>
                                <select class="form-select" id="editCategory"
                                        name="category" required>
                                    <option value="Game" <%= media.category === "Game" ? "selected" : "" %>>Game</option>
                                    <option value="Movie" <%= media.category === "Movie" ? "selected" : "" %>>Movie</option>
                                    <option value="Anime" <%= media.category === "Anime" ? "selected" : "" %>>Anime</option>
                                    <option value="Manga" <%= media.category === "Manga" ? "selected" : "" %>>Manga</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="editDescription" class="form-label">Description</label>
                                <textarea class="form-control" id="editDescription"
                                        name="description" rows="3"><%= media.description %></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="editRating" class="form-label">Rating</label>
                                <input type="number" class="form-control"
                                    id="editRating" name="rating"
                                    min="0" max="10" step="0.1"
                                    value="<%= media.rating %>">
                            </div>

                            <!-- Current Cover -->
                            <div class="mb-3">
                                <label class="form-label">Current Cover</label>
                                <% if(media.coverImage){ %>
                                    <div>
                                        <img src="<%= media.coverImage %>" alt="Current cover"
                                             style="max-width: 150px;">
                                    </div>
                                <% } %>
                            </div>

                            <!-- Replace Cover -->
                            <div class="mb-3">
                                <label for="editCoverImage" class="form-label">Replace Cover Image</label>
                                <input type="file" class="form-control"
                                    id="editCoverImage" name="coverImage"
                                    accept="image/*">
                            </div>
                            <!-- Current Gallery -->
                            <div class="mb-3">
                                <label class="form-label">Current Gallery</label>

                                <% if(media.gallery && media.gallery.length > 0){ %>
                                    <div class="row g-3">
                                        <% media.gallery.forEach(image => { %>
                                            <div class="col-6 col-md-4">
                                                <img src="<%= image %>" alt="Gallery image"
                                                    class="img-fluid rounded mb-2">

                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="removeGalleryImages" value="<%= image %>">
                                                    <label class="form-check-label">
                                                        Remove Image
                                                    </label>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted">No gallery images yet.</p>
                                <% } %>
                            </div>

                            <!-- Add Gallery Images -->
                            <div class="mb-3">
                                <label for="editGalleryImages" class="form-label">Add Gallery Images</label>
                                <input type="file" class="form-control"
                                    id="editGalleryImages" name="galleryImages"
                                    accept="image/*" multiple>
                                <div class="form-text">
                                    You can select up to 10 additional images.
                                </div>
                            </div>
                            <!-- External Links -->
                            <div class="mb-3">
                                <label class="form-label">External Links</label>

                                <div id="editLinksContainer">
                                    <% if(media.links.length > 0){ %>
                                        <% media.links.forEach(link=>{ %>
                                            <div class="input-group mb-2">
                                                <input type="url" class="form-control"
                                                    name="links" value="<%= link %>">
                                                <button type="button"
                                                        class="btn btn-outline-danger remove-link">
                                                    Remove
                                                </button>
                                            </div>
                                        <% }) %>
                                    <% }else{ %>
                                        <input type="url" class="form-control mb-2"
                                            name="links" placeholder="https://example.com">
                                    <% } %>
                                </div>

                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        id="editAddLinkButton">
                                    + Add Another Link
                                </button>
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>