
<div class="modal fade" id="manageCollectionMediaModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form action="/collections/<%= selectedCollection.id %>/media/update"
                  method="POST">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Manage <%= selectedCollection.name %>
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <% if (allMedia.length > 0) { %>
                        <% allMedia.forEach(item => { %>
                            <div class="form-check mb-3">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="mediaIds"
                                       value="<%= item.id %>"
                                       id="media<%= item.id %>"
                                       <%= selectedCollection.mediaIds.includes(item.id) ? "checked" : "" %>>

                                <label class="form-check-label"
                                       for="media<%= item.id %>">
                                    <%= item.title %>
                                    <span class="text-muted">
                                        (<%= item.category %>)
                                    </span>
                                </label>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted">No media entries available.</p>
                    <% } %>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary"
                            <%= allMedia.length === 0 ? "disabled" : "" %>>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
