<!-- Assign Tags Modal -->
<div class="modal fade" id="assignTagsModal" tabindex="-1"
     aria-labelledby="assignTagsModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="assignTagsModalLabel">
                    Manage Tags
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="/media/<%= media.id %>/tags/update" method="POST">
                <div class="modal-body">

                    <% if (allTags.length > 0) { %>
                        <% allTags.forEach(tag => { %>
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="tagIds"
                                       value="<%= tag.id %>"
                                       id="tag<%= tag.id %>"
                                       <%= tags.some(t => t.id === tag.id) ? "checked" : "" %>>

                                <label class="form-check-label"
                                       for="tag<%= tag.id %>">
                                    <%= tag.name %>
                                </label>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted">You haven't created any tags yet.</p>
                    <% } %>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save Tags
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>