<%- include("partials/header") %>
<main class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <h1 class="mb-4">Add Media</h1>

            <form action="/media/add" method="POST">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" class="form-control"
                           id="title" name="title" required>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select" id="category"
                            name="category" required>
                        <option value="" selected disabled>Select a category</option>
                        <option value="Game">Game</option>
                        <option value="Movie">Movie</option>
                        <option value="Anime">Anime</option>
                        <option value="Manga">Manga</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description"
                              name="description" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label for="rating" class="form-label">Rating (0-10)</label>
                    <input type="number" class="form-control"
                           id="rating" name="rating"
                           min="0" max="10" step="0.1" required>
                </div>

                <div class="mb-3">
                    <label for="images" class="form-label">Cover Image Path</label>
                    <input type="text" class="form-control"
                           id="images" name="images"
                           placeholder="/images/example.jpg">
                </div>

                <div class="mb-4">
                    <label for="links" class="form-label">External Link</label>
                    <input type="url" class="form-control"
                           id="links" name="links"
                           placeholder="https://example.com">
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Add Media
                    </button>

                    <a href="/collections" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</main>
<%- include("partials/footer") %>
