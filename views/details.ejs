<%- include("partials/header") %>
<main class="container my-5">
    <% if (media) { %>
        <div class="row g-4">
            <!-- Cover Image -->
            <div class="col-12 col-md-4">
                <% if (media.coverImage) { %>
                    <img src="<%= media.coverImage %>" alt="<%= media.title %>" class="img-fluid rounded details-cover">
                <% } else { %>
                    <div class="image-placeholder details-cover">No Image</div>
                <% } %>
            </div>

            <!-- Media Information -->
            <div class="col-12 col-md-8">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h1 class="mb-0"><%= media.title %></h1>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary"
                                data-bs-toggle="modal" data-bs-target="#editMediaModal">
                            Edit
                        </button>

                        <form action="/media/<%= media.id %>/delete" method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this media?');">
                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>

                <p class="text-muted"><%= media.category %></p>

                <h4><%= media.rating %>/10</h4>

                <!-- Tags -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <% tags.forEach(tag => { %>
                            <span class="badge text-bg-secondary">
                                <%= tag.name %>
                            </span>
                        <% }) %>

                        <button type="button" class="btn btn-outline-primary btn-sm"
                                data-bs-toggle="modal" data-bs-target="#assignTagsModal">
                            Manage Tags
                        </button>
                    </div>
                </div>

                <h4>Description</h4>
                <p><%= media.description %></p>

                <hr>
                    <!-- Tracking -->
                    <h4>Tracking</h4>

                    <% if (tracker) { %>
                        <p><strong>Status:</strong> <%= tracker.status %></p>

                        <% if (tracker.progress && tracker.progress.length > 0) { %>
                            <% tracker.progress.forEach(progress => { %>
                                <p>
                                    <strong><%= progress.unit %>:</strong>
                                    <%= progress.value %>
                                    <% if (progress.total !== undefined) { %>
                                        / <%= progress.total %>
                                    <% } %>
                                </p>
                            <% }) %>
                        <% } %>

                        <button type="button" class="btn btn-primary"
                                data-bs-toggle="modal" data-bs-target="#editTrackerModal">
                            Edit Tracking
                        </button>

                    <% } else { %>
                        <p>Not Started</p>
                        <button type="button" class="btn btn-primary"
                                data-bs-toggle="modal" data-bs-target="#addTrackerModal">
                            Add Tracking
                        </button>
                    <% } %>
                <hr>

                <!-- Links -->
                <h4>Links</h4>
                <% if (media.links && media.links.length > 0) { %>
                    <% media.links.forEach(link => { %>
                        <p>
                            <a href="<%= link %>" target="_blank" rel="noopener noreferrer">
                                <%= new URL(link).hostname %>
                            </a>
                        </p>
                    <% }) %>
                <% } else { %>
                    <p>No links available.</p>
                <% } %>
            </div>
        </div>

        <!-- Gallery -->
        <% if (media.gallery && media.gallery.length > 0) { %>
            <hr class="my-4">

            <h3 class="mb-3">Gallery</h3>

            <div class="row g-3">
                <% media.gallery.forEach(image => { %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <img src="<%= image %>"
                             alt="<%= media.title %> gallery image"
                             class="img-fluid rounded">
                    </div>
                <% }) %>
            </div>
        <% } %>


            <!-- My Reviews -->
            <section class="mt-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">My Reviews</h3>
                </div>

                <!-- Add Review -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Add a Review</h5>

                        <form action="/media/<%= media.id %>/reviews/add" method="POST">
                            <div class="mb-3">
                                <label for="reviewBody" class="form-label">
                                    My Thoughts
                                </label>

                                <textarea class="form-control"
                                        id="reviewBody"
                                        name="bodyText"
                                        rows="4"
                                        placeholder="Write down your thoughts about this media..."
                                        required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Review
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Reviews -->
                <% if (reviews.length > 0) { %>
                    <% reviews.forEach(review => { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <p class="card-text"><%= review.bodyText %></p>

                                <p class="text-muted mb-3">
                                    <small><%= review.date.toLocaleDateString() %></small>
                                </p>

                                <div class="d-flex gap-2">
                                    <!-- Edit Review Button -->
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#editReview<%= review.id %>">
                                        Edit
                                    </button>

                                    <!-- Delete Review Form -->
                                    <form action="/media/<%= media.id %>/reviews/<%= review.id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Delete this review?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </div>

                                <!-- Edit Review Form -->
                                <div class="collapse mt-3" id="editReview<%= review.id %>">
                                    <form action="/media/<%= media.id %>/reviews/<%= review.id %>/edit"
                                        method="POST">
                                        <div class="mb-3">
                                            <label for="reviewBody<%= review.id %>" class="form-label">
                                                Edit My Thoughts
                                            </label>

                                            <textarea class="form-control"
                                                    id="reviewBody<%= review.id %>"
                                                    name="bodyText"
                                                    rows="4"
                                                    required><%= review.bodyText %></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Save Changes
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted">You haven't written any reviews for this media yet.</p>
                <% } %>
            </section>

<%- include("partials/editMediaModal", { media }) %>
<%- include("partials/assignTagsModal", { media, tags, allTags }) %>
    <% if (tracker) { %>
        <%- include("partials/editTrackerModal", { media, tracker }) %>
    <% } else { %>
        <%- include("partials/addTrackerModal", { media }) %>
    <% } %>
    <% } else { %>
        <h2>Media not found</h2>
        <a href="/collections" class="btn btn-secondary">Back to Collection</a>
    <% } %>
    <script>
    const progressContainer = document.getElementById("progressContainer");
    const addProgressButton = document.getElementById("addProgressButton");

    if(addProgressButton){
        addProgressButton.addEventListener("click", ()=>{
            const newRow = document.createElement("div");
            newRow.className = "row g-2 mb-2 progress-row";

            newRow.innerHTML = `
                <div class="col-4">
                    <input type="number" step="any" class="form-control"
                           name="values" placeholder="Current" required>
                </div>

                <div class="col-4">
                    <input type="number" step="any" class="form-control"
                           name="totals" placeholder="Total">
                </div>

                <div class="col-3">
                    <input type="text" class="form-control"
                           name="units" placeholder="Unit" required>
                </div>

                <div class="col-1">
                    <button type="button" class="btn btn-danger remove-progress">×</button>
                </div>
            `;

            progressContainer.appendChild(newRow);
        });

        progressContainer.addEventListener("click", (event)=>{
            if(event.target.classList.contains("remove-progress")){
                event.target.closest(".progress-row").remove();
            }
        });
    }
</script>
</main>
<%- include("partials/footer") %>
